# Copia este archivo como .env. No contiene claves de API: el OCR es local.
# NUNCA subas .env a un repositorio.

# Deja esta linea comentada si Tesseract esta en el PATH.
# En PythonAnywhere normalmente es /usr/bin/tesseract.
# En Windows, si no esta en el PATH:
# TESSERACT_CMD="C:\Program Files\Tesseract-OCR\tesseract.exe"
# TESSERACT_CMD=/usr/bin/tesseract

# spa debe estar instalado; si falta, el motor cae a eng y lo registra en el log.
TESSERACT_LANG=spa+eng

# Carpeta con spa.traineddata/eng.traineddata (por ejemplo /home/USER/tessdata).
# Vacio = usar la carpeta de datos del sistema.
# TESSERACT_TESSDATA=/home/USER/tessdata

# Segmentacion: 6 = bloque de texto, 11 = texto disperso (carteles).
TESSERACT_PSM=6
TESSERACT_FALLBACK_PSM=11
TESSERACT_OEM=1
TESSERACT_TIMEOUT=30

# Si la confianza media del primer pase es menor, reintenta con el PSM alternativo.
TESSERACT_FALLBACK_CONFIDENCE=0.5

# Limita cuantas imagenes procesa Tesseract al mismo tiempo.
OCR_MAX_CONCURRENCY=1
OCR_UPSCALE=true
OCR_UPSCALE_MIN_SIDE=1000
OCR_BORDER=20

# Calidad: endereza paginas inclinadas y prueba variantes si no hay emails.
OCR_DESKEW=true
OCR_DESKEW_MAX_ANGLE=8
OCR_DESKEW_STEP=0.5
OCR_BINARIZE_FALLBACK=true
OCR_DENOISE_FALLBACK=true
# Ultima pasada: recorta la franja inferior de posters verticales donde suele
# estar el contacto. Solo se intenta si no hubo emails y el texto parece una oferta.
OCR_BOTTOM_STRIP_FALLBACK=true
OCR_BOTTOM_STRIP_RATIO=0.30

# Opcionales
# API_KEYS=clave1,clave2          # Protege /v1/extract; vacio = sin autenticacion
# CORS_ORIGINS=*

# Limites de entrada
# MAX_UPLOAD_BYTES=10485760
# MAX_IMAGE_PIXELS=40000000
# MAX_IMAGE_SIDE=1600
